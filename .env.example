# ==============================================================================
# Bilik Baca - File Contoh Konfigurasi Lingkungan (.env.example)
# Salin file ini menjadi .env dan sesuaikan nilai rahasia di lingkungan lokal Anda.
# ==============================================================================

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# String Koneksi Database MySQL (Laragon)
DATABASE_URL=mysql://perpus_app:BilikBacaSecret2026!@127.0.0.1:3306/perpus

# Konfigurasi Sesi Pengguna
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# Keamanan Jaringan & Kiosk
KIOSK_ALLOWED_CIDRS=127.0.0.1/32,192.168.1.0/24
TRUSTED_PROXY_IPS=127.0.0.1

# Kunci Enkripsi Rahasia (32 byte acak Base64 untuk TOTP / Token rahasia)
TOTP_ENC_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS0xMjM0NTY=

# Integrasi API Eksternal Buku
GOOGLE_BOOKS_API_KEY=
OPENLIBRARY_USER_AGENT=BilikBaca (kontak@sekolah.sch.id)

# Integrasi Netri SMS (Supabase Cloud)
NETRI_SUPABASE_URL=https://your-project.supabase.co
NETRI_SUPABASE_KEY=your-supabase-anon-or-service-key

# Penyimpanan Sampul Buku & Direktori Cadangan
COVER_STORAGE_DIR=./public/uploads/covers
BACKUP_DIR=C:\laragon\backup\perpus
